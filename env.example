### Network
# mainnet | testnet
MONAD_NETWORK=mainnet

# If set, overrides the default RPC for the selected network
MONAD_RPC_URL=

### Accounts
# Used by some aggregators (e.g., Kuru, OpenOcean) and for local simulations when enabled
DEFAULT_SENDER_ACCOUNT=

### Quote config
# Global slippage used for quote requests (in basis points). Increase for illiquid routes.
# Example: 2000 = 20%
SLIPPAGE_BPS=2000

### Aggregator auth / toggles
# Kuru Flow API (required if you enable/select Kuru)
KURU_JWT=

# 0x API (optional; only needed if you enable/select 0x)
ZEROX_API_KEY=

### Mace: optional balance-aware retry holders
# JSON map: tokenAddress(lowercase) -> funded holder address
# Tip:
#   export MACE_FROM_ADDRESS_BY_TOKEN="$(cat mace_from_by_token.example.json)"
MACE_FROM_ADDRESS_BY_TOKEN=

### Fork / simulation (optional)
ANVIL_RPC_URL=http://127.0.0.1:8545

